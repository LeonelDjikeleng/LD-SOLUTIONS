# Copiez ce fichier en .env et remplissez les valeurs. Ne commitez jamais .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Adresse publique du site, sans barre oblique finale (sert aux liens des courriels et au plan du site)
SITE_URL=https://www.votre-domaine.ca
# Derrière un proxy inverse (Caddy, Nginx) : 1 pour lire l'IP réelle du visiteur
TRUST_PROXY=1
HTTPS=1

# Base de données et sauvegardes (chemins relatifs à la racine du projet)
DATABASE_PATH=data/ld-solutions.sqlite
BACKUP_DIR=data/sauvegardes
KEEP_BACKUPS=30
RETENTION_MONTHS=24

# Administration : générez la valeur avec `npm run admin:mot-de-passe`
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=8

# Notifications par courriel (SMTP). Exemple Gmail : smtp.gmail.com, port 465,
# SMTP_USER=ldjikeleng@gmail.com et un « mot de passe d'application » Google (pas votre mot de passe habituel).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Leonel Djikeleng <ldjikeleng@gmail.com>"
NOTIFY_TO=ldjikeleng@gmail.com
# Envoyer un accusé de réception au prospect (1 = oui)
SEND_ACKNOWLEDGEMENT=1

# Anti-pourriel
FORM_MIN_DELAY_MS=2500
FORM_RATE_LIMIT=5
