{
  "name": "ld-solutions-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site web de LD SOLUTIONS : création, amélioration et maintenance de sites web.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node src/build.mjs && node --env-file-if-exists=.env --watch-path=server server/index.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node src/build.mjs && node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "qa": "node tests/qa/capture.mjs http://127.0.0.1:3000/ qa-captures 360,390,768,1440",
    "check:prelaunch": "node src/verifier-prelancement.mjs",
    "apercu": "node src/build.mjs && node src/outils/construire-apercu.mjs && node tests/qa/tester-apercu.mjs",
    "admin:mot-de-passe": "node server/scripts/hacher-mot-de-passe.mjs",
    "sauvegarde": "node --env-file-if-exists=.env server/scripts/sauvegarde.mjs",
    "purger": "node --env-file-if-exists=.env server/scripts/purger.mjs"
  },
  "dependencies": {
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "axe-core": "^4.11.4",
    "playwright": "1.56.1"
  }
}
